# Threat-intel keys (empty = source disabled)
VERDIKT_VT_API_KEY=
VERDIKT_ABUSEIPDB_API_KEY=
VERDIKT_URLSCAN_API_KEY=
VERDIKT_ABUSECH_AUTH_KEY=
VERDIKT_OTX_API_KEY=
VERDIKT_GREYNOISE_API_KEY=
VERDIKT_HYBRID_API_KEY=

# Notifications
VERDIKT_SLACK_WEBHOOK_URL=
VERDIKT_TELEGRAM_BOT_TOKEN=
VERDIKT_TELEGRAM_CHAT_ID=
VERDIKT_DISCORD_WEBHOOK_URL=
VERDIKT_TEAMS_WEBHOOK_URL=
VERDIKT_SMTP_HOST=
VERDIKT_SMTP_PORT=587
VERDIKT_SMTP_USER=
VERDIKT_SMTP_PASSWORD=
VERDIKT_SMTP_FROM=
VERDIKT_SMTP_TO=                   # comma-separated recipients
VERDIKT_NOTIFY_COOLDOWN_HOURS=0    # skip a repeat alert for the same indicator and level; 0 = off

# Behaviour
VERDIKT_INTERNAL_DOMAINS=          # comma-separated suffixes, e.g. corp.example.com
VERDIKT_GEOIP_DIR=                 # folder holding GeoLite2-City.mmdb and GeoLite2-ASN.mmdb
VERDIKT_DB_PATH=                   # default: user data dir
VERDIKT_RULES_PATH=                # optional rules.yaml override
VERDIKT_DNS_RESOLVE=false
VERDIKT_REPORT_RETENTION_DAYS=90   # stored reports older than this are deleted at startup; 0 = keep forever
VERDIKT_WATCH_EVERY_HOURS=0       # background watchlist re-check inside verdikt ui; 0 = off, else >= 1
VERDIKT_FEEDS_EVERY_HOURS=0       # background feed refresh; 0 = off, else >= 1
VERDIKT_WATCH_NOTIFY=             # slack, telegram, discord, teams or email for scheduled verdict changes
VERDIKT_WATCH_NOTIFY_ANY=false    # also report downgrades such as suspicious -> safe
VERDIKT_WATCH_MIN_LEVEL=suspicious
VERDIKT_VT_RESOLUTIONS=false      # passive DNS via VirusTotal: one extra VT call per lookup
VERDIKT_CRTSH=false               # crt.sh certificate transparency: slow, often times out
VERDIKT_FEEDS_DIR=                 # downloaded feeds; default: feeds in the user data dir
VERDIKT_AUDIT_LOG=                 # JSON-lines audit log; default: audit.jsonl in the user data dir
